                if (activeButton) {
                    activeButton.classList.add('bg-indigo-600', 'text-white', 'hover:bg-indigo-700');
                    activeButton.classList.remove('text-gray-500', 'hover:text-gray-700', 'hover:border-gray-300', 'border-b-2', 'border-transparent');
                }
                const printButtonContainer = document.getElementById('print-container');
                if (printButtonContainer) {
                    if (targetId === 'tab-source'|| targetId === 'tab-structure') {
                        printButtonContainer.classList.add('hidden');
                    } else {
                        printButtonContainer.classList.remove('hidden');
                    }
                }
            }

            tabButtons.forEach(button => {
                button.addEventListener('click', () => {
                    showTab(button.dataset.target);
                });
            });

            showTab('tab-source');


            // --- DRAG AND DROP LISTENERS ---
            let scrollInterval = null;
            const scrollSpeed = 20;
            const scrollZone = 100;

            document.addEventListener('dragover', (e) => {
                if (!draggedItem) return;
                e.preventDefault();
                const mouseY = e.clientY;
                const viewportHeight = window.innerHeight;
                if (scrollInterval) {
                    clearInterval(scrollInterval);
                    scrollInterval = null;
                }
                if (mouseY < scrollZone) {
                    scrollInterval = setInterval(() => {
                        if (window.scrollY > 0) {
                            window.scrollBy(0, -scrollSpeed);
                        } else {
                            clearInterval(scrollInterval);
                            scrollInterval = null;
                        }
                    }, 50); 
                } else if (mouseY > viewportHeight - scrollZone) {
                    scrollInterval = setInterval(() => {
                        if (window.scrollY + viewportHeight < document.documentElement.scrollHeight) {
                            window.scrollBy(0, scrollSpeed);
                        } else {
                            clearInterval(scrollInterval);
                            scrollInterval = null;
                        }
                    }, 50); 
                }
            });

            function stopScrolling() {
                if (scrollInterval) {
                    clearInterval(scrollInterval);
                    scrollInterval = null;
                }
            }
            
            document.addEventListener('dragend', stopScrolling);
            document.addEventListener('drop', stopScrolling);


            draggables.forEach(draggable => {
                draggable.setAttribute('draggable', true);
                draggable.addEventListener('dragstart', (e) => {
                    const parentTab = draggable.closest('.tab-content');
                    if (!parentTab || parentTab.classList.contains('hidden')) {
                        e.preventDefault();
                        return;
                    }
                    draggedItem = draggable;
                    e.dataTransfer.setData('text/plain', draggable.dataset.word);
                    e.dataTransfer.setData('text/draggable-id', draggable.id);
                    e.dataTransfer.setData('text/data-type', draggable.dataset.type || 'unknown');
                    setTimeout(() => draggable.style.opacity = '0.5', 0);
                });

                draggable.addEventListener('dragend', () => {
                    if (draggedItem && draggedItem.style.opacity !== '0') {
                        draggedItem.style.opacity = '1';
                    }
                    draggedItem = null;
                });
            });

            dropTargets.forEach(target => {
                target.addEventListener('dragover', (e) => {
                    e.preventDefault();
                    target.classList.add('drag-over');
                });

                target.addEventListener('dragleave', () => {
                    target.classList.remove('drag-over');
                });

                target.addEventListener('drop', (e) => {
                    e.preventDefault();
                    target.classList.remove('drag-over');

                    const word = e.dataTransfer.getData('text/plain');
                    const draggedId = e.dataTransfer.getData('text/draggable-id');
                    const wordType = e.dataTransfer.getData('text/data-type');
                    const correctWord = target.dataset.correctWord;
                    const correctType = target.dataset.type;

                    if (target.children.length === 0) {
                        
                        // Prompt Analysis Check
                        if (target.classList.contains('prompt-drop-target-table') && wordType !== correctType) {
                            target.style.borderColor = 'red';
                            setTimeout(() => { target.style.borderColor = '#f97316'; }, 500);
                            return; 
                        }

                        const droppedElement = document.createElement('span');
                        droppedElement.classList.add('dropped-word');
                        droppedElement.textContent = word;
                        droppedElement.dataset.sourceId = draggedId;

                        let isCorrect = false;

                        if (target.classList.contains('prompt-drop-target-table')) {
                             isCorrect = true; 
                             droppedElement.classList.add('bg-orange-700'); 
                        } else if (word === correctWord) {
                            isCorrect = true;
                            droppedElement.classList.add('bg-green-500');
                        } else {
                            droppedElement.classList.add('bg-red-500'); 
                        }

                        if (!isCorrect && !target.classList.contains('prompt-drop-target-table')) {
                            droppedElement.classList.add('bg-red-500');
                        }

                        target.appendChild(droppedElement);
                        
                        let originalWordElement = document.getElementById(draggedId);
                        if (originalWordElement) {
                            originalWordElement.style.display = 'none';
                        }
                        
                        if (target.classList.contains('gist-drop-target-table')) {
                            updateGistResult();
                        }
                    }
                });

                target.addEventListener('dblclick', (e) => {
                    const targetElement = e.target.closest('.drop-target');
                    if (targetElement.id === 'drop-target-t-who') return; 

                    const droppedWordSpan = targetElement.querySelector('.dropped-word');

                    if (droppedWordSpan) {
                        const sourceId = droppedWordSpan.dataset.sourceId;

                        droppedWordSpan.remove();
                        
                        let originalWordElement = document.getElementById(sourceId);
                        if (originalWordElement) {
                            originalWordElement.style.display = 'block';
                            originalWordElement.style.opacity = '1';
                        }

                        if (target.classList.contains('gist-drop-target-table')) {
                            updateGistResult();
                        }
                    }
                });
            });
            
            updateGistResult(); 
        }

        document.addEventListener('DOMContentLoaded', initializeApp);
    </script>
</body>
</html>
