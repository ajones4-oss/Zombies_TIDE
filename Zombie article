<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Title is now set dynamically -->
    <title id="app-title-text"></title>
    <!-- Load Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Existing Custom styles for drag-and-drop */
        .draggable {
            cursor: grab;
            user-select: none;
            transition: transform 0.2s, opacity 0.2s;
        }
        /* ... (rest of the styles remain the same) ... */
        .drop-target {
            min-width: 100px;
            height: 1.5em;
            border-bottom: 2px dashed #9ca3af; /* Gray-400 */
            display: inline-flex;
            justify-content: flex-start;
            align-items: center;
            padding: 0 4px;
            margin: 0 4px;
            font-weight: 500;
            color: #1f2937;
            position: relative;
        }
        .gist-drop-target-table, .prompt-drop-target-table {
            border-bottom: none;
            border: 2px dashed #9ca3af;
            height: 4rem;
            width: 100%;
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 0;
            padding: 8px;
            border-radius: 6px;
        }
        .prompt-drop-target-table {
            min-height: 4rem;
            border-color: #f97316; /* Orange-500 */
        }
        .drop-target.drag-over {
            border-bottom-color: #3b82f6;
            background-color: #eff6ff;
        }
        .dropped-word {
            display: inline-block;
            color: white;
            padding: 4px 10px;
            border-radius: 6px;
            font-size: 0.9em;
            font-weight: 600;
            cursor: default;
        }
        .card {
            background: white;
            padding: 25px;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
            margin-bottom: 20px;
            position: relative;
        }
        .toolbar {
            display: flex;
            gap: 10px;
            margin-bottom: 15px;
            flex-wrap: wrap;
            justify-content: center;
            background: #e9ecef;
            padding: 10px;
            border-radius: 8px;
        }
        .color-btn {
            border: 2px solid transparent;
            padding: 10px 20px;
            border-radius: 20px;
            cursor: pointer;
            font-weight: bold;
            transition: transform 0.2s, box-shadow 0.2s;
            font-size: 0.9rem;
        }
        .color-btn:hover {
            transform: scale(1.05);
        }
        .color-btn.active {
            border-color: #333;
            box-shadow: 0 0 8px rgba(0,0,0,0.3);
            transform: scale(1.05);
        }
        .btn-green { background-color: #d4edda; color: #155724; }
        .btn-yellow { background-color: #fff3cd; color: #856404; }
        .btn-orange { background-color: #ffe5d0; color: #9c4a00; }
        .btn-pink { background-color: #f8d7da; color: #721c24; }
        .btn-eraser { background-color: #ffffff; border: 1px solid #ccc; color: #333; }
        .sentence {
            cursor: pointer;
            padding: 3px 2px;
            border-radius: 4px;
            transition: background-color 0.2s;
            margin-right: 2px;
            display: inline-block; 
        }
        .sentence:hover {
            background-color: #e2e6ea;
            outline: 1px dashed #ccc;
        }
        .highlight-green { background-color: #d4edda; border-bottom: 2px solid #28a745; }
        .highlight-yellow { background-color: #fff3cd; border-bottom: 2px solid #ffc107; }
        .highlight-orange { background-color: #ffe5d0; border-bottom: 2px solid #fd7e14; }
        .highlight-pink { background-color: #f8d7da; border-bottom: 2px solid #dc3545; }
        .instructions {
            text-align: center;
            margin-bottom: 15px;
            font-style: italic;
            color: #666;
        }
        .tip-box {
            font-size: 0.9rem;
            background: #eef;
            padding: 10px;
            border-radius: 5px;
            margin-bottom: 15px;
            border: 1px solid #ccd;
        }
             /* Custom CSS for robust tooltip visibility */
        .tooltip-hidden {
            opacity: 0;
            visibility: hidden;
            transform: translateY(0);
        }
        .tooltip-visible {
            opacity: 1;
            visibility: visible;
            transform: translateY(8px); /* Same as group-hover:translate-y-2 (which is ~8px) */
        }

        @media print {
            .no-print, .toolbar, .instructions, .tip-box {
                display: none !important;
            }
            .tab-content {
                display: block !important;
            }
            #essay-content, .card {
                border: none !important; 
                box-shadow: none !important;
            }
            .highlight-green, .highlight-yellow, .highlight-orange, .highlight-pink, .passage-text {
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }
    </style>
</head>
<body class="bg-gray-50 font-sans p-4 md:p-8">

    <div class="max-w-4xl mx-auto bg-white shadow-xl rounded-xl p-6 md:p-10">

        <header class="mb-8 border-b pb-4">
            <!-- Dynamic Title -->
            <h1 id="main-title" class="text-4xl font-extrabold text-gray-800 mb-2"></h1>
            <p class="text-lg text-gray-600">Drag words, complete sections, and finalize your essay.</p>
        </header>

        <!-- Tab Navigation -->
        <div class="mb-6 border-b border-gray-200 no-print">
            <nav class="-mb-px flex space-x-4 md:space-x-8" aria-label="Tabs">
                <button 
                    id="tab-source-button"
                    class="tab-button py-3 px-4 font-medium text-lg text-white rounded-t-lg bg-indigo-600 hover:bg-indigo-700 transition duration-150"
                    data-target="tab-source">
                    Source
                </button>
                <button 
                    id="tab-gist-button"
                    class="tab-button py-3 px-4 font-medium text-lg text-gray-500 hover:text-gray-700 hover:border-gray-300 border-b-2 border-transparent transition duration-150"
                    data-target="tab-gist">
                    Gist
                </button>
                <button 
                    id="tab-prompt-analysis-button"
                    class="tab-button py-3 px-4 font-medium text-lg text-gray-500 hover:text-gray-700 hover:border-gray-300 border-b-2 border-transparent transition duration-150"
                    data-target="tab-prompt-analysis">
                    Pull Apart the Prompt
                </button>
                              <!-- NEW TIDE STRUCTURE TAB BUTTON -->
                <button 
                    id="tab-structure-button"
                    class="tab-button py-3 px-4 font-medium text-lg text-gray-500 hover:text-gray-700 hover:border-gray-300 border-b-2 border-transparent transition duration-150"
                    data-target="tab-structure">
                    TIDE Structure
                </button>
                <button 
                    id="tab-draft-button"
                    class="tab-button py-3 px-4 font-medium text-lg text-gray-500 hover:text-gray-700 hover:border-gray-300 border-b-2 border-transparent transition duration-150"
                    data-target="tab-draft">
                    TIDE Draft
                </button>
                <button 
                    id="tab-highlight-button"
                    class="tab-button py-3 px-4 font-medium text-lg text-gray-500 hover:text-gray-700 hover:border-gray-300 border-b-2 border-transparent transition duration-150"
                    data-target="tab-highlight">
                    Highlight TIDE
                </button>
            </nav>
        </div>

        <!-- Tab Content Containers -->
        
        <!-- Source Text & Data Tab Content (DEFAULT) -->
        <div id="tab-source" class="tab-content">
            <div class="mb-8 p-4 bg-yellow-50 border-l-4 border-yellow-400 rounded-lg shadow-inner">
                <!-- Dynamic Source Title -->
                <h2 id="source-title" class="text-2xl font-bold text-yellow-800 mb-3"></h2>
                <div class="flex flex-col lg:flex-row gap-6">
                    <!-- Dynamic Source Text -->
                    <p class="text-gray-700 leading-relaxed lg:w-3/5" id="source-text-main"></p>
                    <div class="lg:w-2/5 flex flex-col items-center justify-center">
                        <!-- Image 1 -->
                        <img id="source-image-1" src="" 
                            alt="Image of the source topic" 
                            class="rounded-lg shadow-md mb-2 w-full h-auto max-h-56 object-cover">
                    </div>
                </div>
            </div>

            <!-- Visual Data Images for Size and Weight -->
            <div class="p-6 bg-gray-100 rounded-xl shadow-md border border-gray-200">
                <h2 class="text-2xl font-bold text-gray-700 mb-4 border-b pb-2">Topic Visual Data</h2>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                    <!-- Height Comparison Image -->
                    <div class="p-4 bg-white rounded-lg shadow-lg flex flex-col items-center">
                        <h3 id="source-image-2-title" class="text-xl font-semibold text-gray-800 mb-3 text-center"></h3>
                        <!-- Image 2 -->
                        <img id="source-image-2" src="" 
                            alt="Comparison scale image" 
                            class="rounded-lg shadow-md w-full h-auto max-h-56 object-contain">
                        <p id="source-image-2-caption" class="text-sm mt-2 text-gray-600"></p>
                    </div>

                    <!-- Weight Reference Image -->
                    <div class="p-4 bg-white rounded-lg shadow-lg flex flex-col items-center">
                        <h3 id="source-image-3-title" class="text-xl font-semibold text-gray-800 mb-3 text-center"></h3>
                        <!-- Image 3 -->
                        <img id="source-image-3" src="" 
                            alt="Weight scale image" 
                            class="rounded-lg shadow-md w-full h-auto max-h-56 object-contain">
                        <p id="source-image-3-caption" class="text-sm mt-2 text-gray-600"></p>
                    </div>

                </div>
            </div>
        </div>

        <!-- Gist Tab Content -->
        <div id="tab-gist" class="tab-content hidden">
            <h2 class="text-3xl font-bold text-gray-800 mb-6 border-b pb-2">Gist: Formulating the Main Idea</h2>
            <p class="text-lg text-gray-600 mb-6">Drag the components below to build your Gist/Topic sentence. </p>

            <!-- Source Text Duplicate for Reference -->
            <div class="mb-8 p-4 bg-yellow-50 border-l-4 border-yellow-400 rounded-lg shadow-inner">
                <h2 id="gist-source-title" class="text-2xl font-bold text-yellow-800 mb-3"></h2>
                <div id="gist-source-text">
                    <p class="text-gray-700 leading-relaxed"></p>
                </div>
            </div>
            <!-- End Source Text Duplicate -->


            <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 mb-8">
                <!-- 1/4 COLUMN: Gist Word Bank -->
                <div class="lg:col-span-1 p-4 bg-purple-50 rounded-lg shadow-md border border-purple-200 h-fit">
                    <h3 class="text-xl font-semibold text-purple-700 mb-3">Gist Components</h3>
                    <!-- Dynamic Gist Word Bank -->
                    <div id="gist-word-bank" class="flex flex-wrap gap-2">
                        <!-- Content will be injected by JS -->
                    </div>
                </div>

                <!-- 3/4 COLUMN: Gist Sentence Builder -->
                <div class="lg:col-span-3 p-2 bg-white rounded-lg shadow-xl border-t-4 border-purple-500">
                    <h3 class="text-2xl font-bold text-purple-700 mb-4 px-4">Gist Sentence Chart</h3>
                    
                    <div class="w-full border border-gray-300 rounded-lg overflow-hidden">
                        
                        <!-- Header Row 1 -->
                        <div class="grid grid-cols-6 font-bold text-white bg-purple-600">
                            <div class="col-span-1 p-3 border-r border-purple-700 text-center">Who?</div>
                            <div class="col-span-1 p-3 border-r border-purple-700 text-center">Did what?</div>
                            <div class="col-span-1 p-3 border-r border-purple-700 text-center">When? Where?</div>
                            <div class="col-span-3 p-3 text-center">Why/What happened?</div> 
                        </div>

                        <!-- Header Row 2 -->
                        <div class="grid grid-cols-6 text-sm font-semibold text-gray-700 bg-purple-100 border-b border-gray-300">
                            <div class="col-span-3"></div> 
                            <div class="p-2 border-r border-gray-300 text-center">Joiner</div>
                            <div class="p-2 border-r border-gray-300 text-center">Who?</div>
                            <div class="p-2 text-center">Did what?</div>
                        </div>

                        <!-- Drop Target Row (IDs match the config structure) -->
                        <div class="grid grid-cols-6 items-center bg-white p-2 gap-2">
                          <div 
class="flex justify-center p-1"> <span id="gist-drop-who-1" data-correct-word="" class="drop-target gist-drop-target-table flex-1"></span> </div>
                            <div class="flex justify-center p-1"> <span id="gist-drop-what-1" data-correct-word="" class="drop-target gist-drop-target-table flex-1"></span> </div>
                            <div 
                             class="flex justify-center p-1"> <span id="gist-drop-where" data-correct-word="" class="drop-target gist-drop-target-table flex-1"></span> </div>
                            <div class="flex justify-center p-1"> <span id="gist-drop-joiner" data-correct-word="" class="drop-target gist-drop-target-table flex-1"></span> </div>
                            <div class="flex justify-center p-1"> <span id="gist-drop-who-2" data-correct-word="" class="drop-target gist-drop-target-table flex-1"></span> </div>
                            <div class="flex justify-center p-1"> <span id="gist-drop-what-2" data-correct-word="" class="drop-target gist-drop-target-table flex-1"></span> </div>
                        </div>

                    </div>

                    <div class="mt-8 pt-4 border-t border-gray-200 px-4">
                        <h3 class="text-xl font-semibold text-gray-700 mb-2">Final Gist Sentence (Topic Sentence):</h3>
                        <p id="gist-result" class="text-lg text-gray-900 bg-gray-50 p-3 rounded-md border border-gray-200 font-medium min-h-[3rem]">
                            Drag all components into the chart above to form the sentence.
                        </p>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Pull Apart the Prompt Tab Content -->
        <div id="tab-prompt-analysis" class="tab-content hidden">
            <h2 class="text-3xl font-bold text-gray-800 mb-6 border-b pb-2">Pull Apart the Prompt</h2>
            <p class="text-lg text-gray-600 mb-6">Analyze the prompt below by dragging the components into the correct "Do" (action/verb) or "What" (content/requirement) columns.</p>

            <!-- The Prompt -->
            <div class="mb-8 p-4 bg-orange-50 border-l-4 border-orange-500 rounded-lg shadow-inner">
                <h3 class="text-xl font-bold text-orange-800 mb-3">Assignment Prompt:</h3>
                <!-- Dynamic Prompt Text -->
                <p id="assignment-prompt-text" class="text-xl font-semibold text-gray-800 leading-relaxed"></p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 mb-8">
                <!-- 1/4 COLUMN: Prompt Word Bank -->
                <div class="lg:col-span-1 p-4 bg-orange-500 rounded-lg shadow-md border border-orange-600 h-fit">
                    <h3 class="text-xl font-semibold text-white mb-3">Prompt Components</h3>
                    <!-- Dynamic Prompt Word Bank -->
                    <div id="prompt-word-bank" class="flex flex-wrap gap-2">
                        <!-- Content will be injected by JS -->
                    </div>
                </div>

                <!-- 3/4 COLUMN: T-Chart Drop Zones -->
                <div class="lg:col-span-3 p-2 bg-white rounded-lg shadow-xl border-t-4 border-orange-500">
                    <h3 class="text-2xl font-bold text-orange-700 mb-4 px-4">T-Chart </h3>
                    
                    <div class="grid grid-cols-2 w-full border border-gray-300 rounded-lg overflow-hidden">
                        
                        <!-- Header Row -->
                        <div class="font-bold text-white bg-orange-600 p-3 border-r border-orange-700 text-center">Do </div>
                        <div class="font-bold text-white bg-orange-600 p-3 text-center">What </div>

                        <!-- Drop Targets (IDs for the 3 Do and 3 What targets) -->
                        <div id="prompt-do-targets" class="p-2 border-r border-gray-300 space-y-2 bg-orange-100">
                            <span id="prompt-drop-do-1" data-type="Do" class="drop-target prompt-drop-target-table w-full"></span>
                            <span id="prompt-drop-do-2" data-type="Do" class="drop-target prompt-drop-target-table w-full"></span>
                            <span id="prompt-drop-do-3" data-type="Do" class="drop-target prompt-drop-target-table w-full"></span>
                        </div>
                        <div id="prompt-what-targets" class="p-2 space-y-2 bg-orange-50">
                            <span id="prompt-drop-what-1" data-type="What" class="drop-target prompt-drop-target-table w-full"></span>
                            <span id="prompt-drop-what-2" data-type="What" class="drop-target prompt-drop-target-table w-full"></span>
                            <span id="prompt-drop-what-3" data-type="What" class="drop-target prompt-drop-target-table w-full"></span>
                        </div>

                    </div>
                    
                </div>
            </div>
        </div>
        <!-- UPDATED TIDE STRUCTURE TAB CONTENT with onmouseover/onmouseout -->
        <div id="tab-structure" class="tab-content hidden">
            <h2 class="text-3xl font-bold text-indigo-700 mb-6 border-b pb-2">The T.I.D.E. Essay Structure</h2>
            <p class="text-lg text-gray-600 mb-8">Hover over each step to view sentence starter ideas for your draft.</p>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                
                <!-- T: Topic -->
                <div id="tide-box-t" onmouseover="showStarters('starters-t')" onmouseout="hideStarters('starters-t')" class="relative p-5 bg-green-100 rounded-xl shadow-md border-t-4 border-green-500 flex flex-col items-center text-center cursor-pointer hover:shadow-lg transition duration-200">
                    <div class="text-6xl mb-3">💡</div>
                    <h3 class="text-2xl font-bold text-green-800 mb-2">T: Topic</h3>
                    <p class="text-sm text-gray-700">Gist / Main Idea / Answer the Question</p>
                    <p class="text-xs text-gray-500 mt-2">(The first sentence of your paragraph)</p>

                    <!-- Tooltip Container (JS controlled) -->
                    <div id="starters-t" class="absolute tooltip-hidden w-[150%] max-w-xs md:max-w-sm z-10 p-4 mt-2 top-full left-1/2 -translate-x-1/2 bg-gray-800 text-white text-left text-sm rounded-lg shadow-xl pointer-events-none transition duration-300">
                        <!-- Content injected by JS -->
                    </div>
                </div>

                <!-- I: Information -->
                <div id="tide-box-i" onmouseover="showStarters('starters-i')" onmouseout="hideStarters('starters-i')" class="relative p-5 bg-yellow-100 rounded-xl shadow-md border-t-4 border-yellow-500 flex flex-col items-center text-center cursor-pointer hover:shadow-lg transition duration-200">
                    <div class="text-6xl mb-3">📖</div>
                    <h3 class="text-2xl font-bold text-yellow-800 mb-2">I: Information</h3>
                    <p class="text-sm text-gray-700">Support your topic with information/evidence from the text.</p>
                    <p class="text-xs text-gray-500 mt-2">(Usually a direct quote or paraphrase)</p>

                    <!-- Tooltip Container (JS controlled) -->
                    <div id="starters-i" class="absolute tooltip-hidden w-[150%] max-w-xs md:max-w-sm z-10 p-4 mt-2 top-full left-1/2 -translate-x-1/2 bg-gray-800 text-white text-left text-sm rounded-lg shadow-xl pointer-events-none transition duration-300">
                        <!-- Content injected by JS -->
                    </div>
                </div>

                <!-- D: Details -->
                <div id="tide-box-d" onmouseover="showStarters('starters-d')" onmouseout="hideStarters('starters-d')" class="relative p-5 bg-orange-100 rounded-xl shadow-md border-t-4 border-orange-500 flex flex-col items-center text-center cursor-pointer hover:shadow-lg transition duration-200">
                    <div class="text-6xl mb-3">🧠</div>
                    <h3 class="text-2xl font-bold text-orange-800 mb-2">D: Details</h3>
                    <p class="text-sm text-gray-700">Explain, elaborate, or say more about the Information in your own words.</p>
                    <p class="text-xs text-gray-500 mt-2">(Your analysis or connection to the topic)</p>

                    <!-- Tooltip Container (JS controlled) -->
                    <div id="starters-d" class="absolute tooltip-hidden w-[150%] max-w-xs md:max-w-sm z-10 p-4 mt-2 top-full left-1/2 -translate-x-1/2 bg-gray-800 text-white text-left text-sm rounded-lg shadow-xl pointer-events-none transition duration-300">
                        <!-- Content injected by JS -->
                    </div>
                </div>

                <!-- E: Ending -->
                <div id="tide-box-e" onmouseover="showStarters('starters-e')" onmouseout="hideStarters('starters-e')" class="relative p-5 bg-pink-100 rounded-xl shadow-md border-t-4 border-pink-500 flex flex-col items-center text-center cursor-pointer hover:shadow-lg transition duration-200">
                    <div class="text-6xl mb-3">🔄💡</div>
                    <h3 class="text-2xl font-bold text-pink-800 mb-2">E: Ending</h3>
                    <p class="text-sm text-gray-700">Restate the Topic sentence using different words.</p>
                    <p class="text-xs text-gray-500 mt-2">(The final sentence of your paragraph)</p>

                    <!-- Tooltip Container (JS controlled) -->
                    <div id="starters-e" class="absolute tooltip-hidden w-[150%] max-w-xs md:max-w-sm z-10 p-4 mt-2 top-full left-1/2 -translate-x-1/2 bg-gray-800 text-white text-left text-sm rounded-lg shadow-xl pointer-events-none transition duration-300">
                        <!-- Content injected by JS -->
                    </div>
                </div>
            </div>
        </div>
        <!-- TIDE Draft Tab Content -->
        <div id="tab-draft" class="tab-content hidden">
            <h2 class="text-3xl font-bold text-green-700 mb-6 border-b pb-2">TIDE Step-by-Step Draft</h2>
            
            <!-- Source Text Duplicate for Reference (Text Only) -->
            <div class="mb-8 p-4 bg-yellow-50 border-l-4 border-yellow-400 rounded-lg shadow-inner">
                <h3 id="draft-source-title" class="text-2xl font-bold text-yellow-800 mb-3"></h3>
                <div id="draft-source-text">
                    <p class="text-gray-700 leading-relaxed"></p>
                </div>
            </div>
            
            <!-- ASSIGNMENT PROMPT FOR REFERENCE (NEW SECTION) -->
            <div class="mb-8 p-4 bg-orange-50 border-l-4 border-orange-500 rounded-lg shadow-inner">
                <h3 class="text-xl font-bold text-orange-800 mb-3">Assignment Prompt:</h3>
                <!-- Dynamic Prompt Text -->
                <p id="draft-assignment-prompt-text" class="text-gray-700 leading-relaxed"></p>
            </div>
            <!-- END NEW SECTION -->

            <div class="flex flex-col md:flex-row justify-between gap-8 mb-10 items-start">
                
                <!-- 1/3 COLUMN: Word Bank - Sticky fix wrapper -->
                <div class="md:w-1/3 md:sticky md:top-8">
                    <div class="p-6 bg-blue-50 border border-blue-200 rounded-lg shadow-md">
                        <h2 class="text-2xl font-bold text-blue-700 mb-4">Word Bank</h2>
                        <!-- Dynamic Word Bank -->
                        <div id="word-bank" class="flex flex-wrap gap-3">
                            <!-- Content will be injected by JS -->
                        </div>
                    </div>
                </div>

                <!-- 2/3 COLUMN: TIDE Structure Assignment -->
                <div class="md:w-2/3">

                    <div id="tide-steps" class="space-y-6">

                        <!-- T (Topic) -->
                        <div id="tide-t-section" class="p-4 bg-green-50 rounded-lg shadow-sm border border-green-200">
                            <h3 class="text-xl font-semibold text-green-800 mb-2">T (Topic) - Gist / Main Idea</h3>
                            <p id="tide-t-sentence" class="text-gray-700">
                                <!-- Sentence injected here -->
                            </p>
                            <small class="text-gray-500">This sentence is your Topic Sentence, from the Gist.</small>
                        </div>

                        <!-- I (Information 1) & D (Details 1) -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div id="tide-i1-section" class="p-4 bg-yellow-50 rounded-lg shadow-sm border border-yellow-200">
                                <h3 class="text-xl font-semibold text-yellow-800 mb-2">I1 (Information)</h3>
                                <p id="tide-i1-sentence" class="text-gray-700">
                                    <!-- Sentence injected here -->
                                </p>
                            </div>
                            <div class="p-4 bg-orange-100 rounded-lg shadow-sm border border-orange-300">
                                <h3 id="tide-d1-title" class="text-xl font-semibold text-orange-800 mb-2">D1 (Details)</h3>
                                <p id="tide-d1-prefix" class="text-gray-700 mb-2 font-medium"></p>
